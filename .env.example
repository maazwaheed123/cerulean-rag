# Copy this file to .env and adjust if needed. Every key has a working default
# in src/cerulean_rag/config.py, so an empty .env is also fine.

# --- Ollama ---------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
GEN_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text

# --- "Current" date for the corpus (assignment as-of date) -----------------
# Taken from config, NOT from the system clock, so results are reproducible.
AS_OF_DATE=2026-08-27

# --- Paths ----------------------------------------------------------------
CORPUS_DIR=./corpus
CHROMA_DIR=./data/chroma
CHUNKS_FILE=./data/chunks.jsonl
COLLECTION_NAME=cerulean_docs

# --- Retrieval ------------------------------------------------------------
TOP_K=8
# candidates taken from each of vector search and BM25 before fusion
RETRIEVE_K_PER_SOURCE=10
# nomic cosine similarity for good hits is typically 0.6-0.8; calibrated in Step 9
SIM_THRESHOLD=0.45
USE_BM25=true

# --- Generation -----------------------------------------------------------
NUM_CTX=8192
TEMPERATURE=0
SEED=42
MAX_ANSWER_TOKENS=700

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
QUERY_LOG=./logs/queries.jsonl
